# Copied to .env on first run. .env is gitignored and never sent to the browser.

# One API key is all the studio needs — OpenAI or Anthropic, whichever you have. Easiest is to
# leave both blank and let the studio ask on first launch; it verifies the key, works out which
# provider it belongs to, and writes it here for you.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional, and only consulted when both keys are set: which provider to use, "openai" or
# "anthropic". The studio writes this whenever you connect a key from the UI.
# AI_PROVIDER=anthropic

# Optional. Leave unset and the studio auto-picks the best model your key can see.
# OPENAI_MODEL=gpt-5.5
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Port for the studio.
# PORT=4400
